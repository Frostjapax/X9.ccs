cat << 'EOF' > painel.sh
#!/data/data/com.termux/files/usr/bin/bash

# ==========================================
# CONFIGURAÇÃO DE CAMINHO E PERSISTÊNCIA
# ==========================================
CONFIG_FILE="$PREFIX/tmp/termux_black_theme.cfg"
FIXED_FILE="$PREFIX/tmp/termux_black_fixed.cfg"
LOG_FILE="$PREFIX/tmp/termux_black_diagnostic.log"

WHITE='\033[1;37m'
GRAY='\033[1;30m'
NC='\033[0m'
COLOR_PRIMARY='\033[1;30m'
COLOR_SECONDARY='\033[1;37m'
TEMA_NOME="BLACK VIP"
EMOJI_TEMA="👾 "
CLICK_MS="10 ms"

# ==========================================
# APLICAR CORES DO TEMA SELECIONADO
# ==========================================
aplicar_tema() {
    case "$1" in
        1) COLOR_PRIMARY='\033[1;30m'; COLOR_SECONDARY='\033[1;37m'; TEMA_NOME="BLACK VIP"; EMOJI_TEMA="👾 " ;;
        2) COLOR_PRIMARY='\033[1;31m'; COLOR_SECONDARY='\033[38;5;88m'; TEMA_NOME="RED VIP"; EMOJI_TEMA="🩸👾 " ;;
        3) COLOR_PRIMARY='\033[1;36m'; COLOR_SECONDARY='\033[38;5;33m'; TEMA_NOME="CYBER NEON"; EMOJI_TEMA="⚡👾 " ;;
        4) COLOR_PRIMARY='\033[1;35m'; COLOR_SECONDARY='\033[38;5;129m'; TEMA_NOME="PURPLE TOXIC"; EMOJI_TEMA="🔮👾 " ;;
        5) COLOR_PRIMARY='\033[1;32m'; COLOR_SECONDARY='\033[38;5;34m'; TEMA_NOME="MATRIX GREEN"; EMOJI_TEMA="🟢👾 " ;;
        6) COLOR_PRIMARY='\033[1;33m'; COLOR_SECONDARY='\033[38;5;208m'; TEMA_NOME="GOLD VIP"; EMOJI_TEMA="👑👾 " ;;
        *) COLOR_PRIMARY='\033[1;30m'; COLOR_SECONDARY='\033[1;37m'; TEMA_NOME="BLACK VIP"; EMOJI_TEMA="👾 " ;;
    esac
}

selecionar_tema() {
    clear
    echo -e "\033[1;37m ╭───────────────────────────────────────────────────╮\033[0m"
    echo -e "\033[1;37m │\033[1;37m  👾 SELEÇÃO DE TEMA DO PAINEL | OPERADOR: 7VN     \033[1;37m │\033[0m"
    echo -e "\033[1;37m ├───────────────────────────────────────────────────┤\033[0m"
    echo -e "\033[1;37m │\033[1;30m  [1] 👾 BLACK VIP (Preto & Branco - Padrão)        \033[1;37m │\033[0m"
    echo -e "\033[1;37m │\033[1;31m  [2] 🩸👾 RED VIP (Vermelho & Preto)               \033[1;37m │\033[0m"
    echo -e "\033[1;37m │\033[1;36m  [3] ⚡👾 CYBER NEON (Ciano & Azul)                \033[1;37m │\033[0m"
    echo -e "\033[1;37m │\033[1;35m  [4] 🔮👾 PURPLE TOXIC (Roxo & Violeta)            \033[1;37m │\033[0m"
    echo -e "\033[1;37m │\033[1;32m  [5] 🟢👾 MATRIX GREEN (Verde Hacker)              \033[1;37m │\033[0m"
    echo -e "\033[1;37m │\033[1;33m  [6] 👑👾 GOLD VIP (Dourado & Amarelo)             \033[1;37m │\033[0m"
    echo -e "\033[1;37m ╰───────────────────────────────────────────────────╯\033[0m"
    echo ""
    echo -n -e " 👾 ESCOLHA SEU TEMA, 7VN [1-6]: "
    read -r op_tema
    op_tema=$(echo "$op_tema" | tr -dc '0-9')
    echo "$op_tema" > "$CONFIG_FILE"
    aplicar_tema "$op_tema"
}

carregar_tema() {
    if [ -f "$CONFIG_FILE" ]; then
        local tema_salvo=$(cat "$CONFIG_FILE" | tr -dc '0-9')
        aplicar_tema "$tema_salvo"
    else
        selecionar_tema
    fi
}

exibir_cabecalho() {
    clear
    echo -e "${COLOR_SECONDARY}"
    echo "  ██╗  ██╗██████╗ ██████╗ ██████╗███████╗"
    echo "  ╚██╗██╔╝██╔══██╗██╔════╝██╔════╝██╔════╝"
    echo "   ╚███╔╝ ███████║██║     ██║     ███████╗"
    echo "   ██╔██╗ ╚════██║██║     ██║     ╚════██║"
    echo "  ██╔╝ ██╗     ██║╚██████╗╚██████╗███████║"
    echo "  ╚═╝  ╚═╝     ╚═╝ ╚═════╝ ╚═════╝╚══════╝"
    echo -e "${COLOR_SECONDARY} ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
    echo -e "${WHITE}  👾 FREE FIRE ULTRA VIP | OPERADOR: 7VN | TEMA: ${TEMA_NOME}${NC}"
    echo -e "${WHITE}  👾 MODO: CAPA REGEDIT | LATÊNCIA: ${CLICK_MS}${NC}"
    echo -e "${COLOR_SECONDARY} ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
    echo ""
}

# ==========================================
# FUNÇÕES DE CONFIGURAÇÃO E TWEAKS
# ==========================================
configurar_eixos_xy() {
    exibir_cabecalho
    echo -e "${COLOR_SECONDARY} 👾 [!] CONFIGURANDO SUA X E Y...${NC}"
    echo -e "${GRAY} Calibrando multiplicadores, velocidade e viés vertical...${NC}\n"
    
    echo -e "${WHITE} 👾 [1/5] Injetando debug.touch.x_multiplier & y_multiplier...${NC}"
    setprop debug.touch.x_multiplier 3.2 > /dev/null 2>&1
    setprop debug.touch.y_multiplier 3.65 > /dev/null 2>&1
    sleep 0.3
    
    echo -e "${WHITE} 👾 [2/5] Injetando persist.sys.input.x.speed & y.speed...${NC}"
    setprop persist.sys.input.x.speed max > /dev/null 2>&1
    setprop persist.sys.input.y.speed max > /dev/null 2>&1
    sleep 0.3
    
    echo -e "${WHITE} 👾 [3/5] Injetando touch.x.scale & touch.y.scale...${NC}"
    setprop touch.x.scale 1.05 > /dev/null 2>&1
    setprop touch.y.scale 1.18 > /dev/null 2>&1
    sleep 0.3
    
    echo -e "${WHITE} 👾 [4/5] Injetando debug.touch.x_precision & y_precision...${NC}"
    setprop debug.touch.x_precision 100 > /dev/null 2>&1
    setprop debug.touch.y_precision 100 > /dev/null 2>&1
    sleep 0.3
    
    echo -e "${WHITE} 👾 [5/5] Injetando persist.sys.dispatch.y_bias (Puxada Vermelha)...${NC}"
    setprop persist.sys.dispatch.x_bias 0.0 > /dev/null 2>&1
    setprop persist.sys.dispatch.y_bias 0.25 > /dev/null 2>&1
    sleep 0.3
    
    echo -e "\n${COLOR_SECONDARY} 👾 [★] 5 CÓDIGOS DE EIXOS X E Y APLICADOS COM SUCESSO, 7VN!${NC}"
    echo ""
    read -r -p " 👾 Pressione [Enter] para voltar ao menu..." dummy
}

gerar_xy() {
    exibir_cabecalho
    echo -e "${COLOR_SECONDARY} ╭───────────────────────────────────────────────────╮${NC}"
    echo -e "${COLOR_SECONDARY} │${WHITE}  👾 GERADOR INTELIGENTE DE EIXOS X & Y (FREE FIRE) ${COLOR_SECONDARY} │${NC}"
    echo -e "${COLOR_SECONDARY} ╰───────────────────────────────────────────────────╯${NC}"
    echo ""
    
    local modelo_detectado=$(getprop ro.product.model 2>/dev/null)
    if [ -z "$modelo_detectado" ]; then
        modelo_detectado="POCO F8"
    fi
    
    echo -e "${WHITE} 👾 Modelo detectado no sistema: ${COLOR_SECONDARY}${modelo_detectado}${NC}"
    read -r -p " 👾 Digite o modelo do celular (ex: POCO F8) ou [Enter] para '${modelo_detectado}': " modelo_user
    modelo_user=$(echo "$modelo_user" | tr -d '\r')
    if [ -n "$modelo_user" ]; then
        modelo_detectado="$modelo_user"
    fi
    
    local res_str=$(wm size 2>/dev/null | awk '{print $3}')
    if [ -z "$res_str" ]; then res_str="1080x2400"; fi
    local res_w=$(echo "$res_str" | cut -dx -f1)
    local res_h=$(echo "$res_str" | cut -dx -f2)
    
    echo -e "\n${COLOR_SECONDARY} 👾 [!] OBTENDO RESOLUÇÃO (${res_w}x${res_h}) E CALIBRANDO DPI...${NC}"
    sleep 0.8
    
    local str_len=${#modelo_detectado}
    local calc_x=$(( (str_len * 7 + 45) % 35 + 60 ))
    local calc_y=$(( calc_x + 12 ))
    local dpi_rec=$(( (calc_x * 8) + 120 ))
    local mult_x="3.$(( calc_x % 10 + 1 ))"
    local mult_y="3.$(( calc_y % 10 + 5 ))"
    
    local sen_geral=$(( 200 - ((dpi_rec * 100) / (res_w + 500)) ))
    if [ $sen_geral -gt 200 ]; then sen_geral=200; fi
    if [ $sen_geral -lt 100 ]; then sen_geral=100; fi
    
    local sen_reddot=$(( sen_geral - 4 ))
    local sen_2x=$(( sen_geral - 10 ))
    local sen_4x=$(( sen_geral - 16 ))
    local sen_awm=$(( sen_geral - 35 ))
    local sen_olhadinha=$(( sen_geral - 20 ))
    
    echo -e "\n${WHITE} ━━━ 👾 CONFIGURAÇÃO GERADA PARA FREE FIRE (${modelo_detectado}) ━━━${NC}"
    echo -e " ${COLOR_SECONDARY}► RESOLUÇÃO TELA DETECTADA  :${WHITE} ${res_w}x${res_h}${NC}"
    echo -e " ${COLOR_SECONDARY}► EIXO X (Movimentação Horizontal) :${WHITE} ${calc_x}% (Multiplier: ${mult_x})${NC}"
    echo -e " ${COLOR_SECONDARY}► EIXO Y (Puxada de Capa Vertical):${WHITE} ${calc_y}% (Multiplier: ${mult_y})${NC}"
    echo -e " ${COLOR_SECONDARY}► DPI IDEAL CALCULADA       :${WHITE} ${dpi_rec} DPI${NC}"
    echo -e " ${COLOR_SECONDARY}► VELOCIDADE DO PONTEIRO    :${WHITE} Máxima (-1)${NC}"
    echo -e "${WHITE} ━━━ 👾 SENSIBILIDADE CALCULADA (ESCALA 100-200) ━━━${NC}"
    echo -e " ${WHITE} Geral: ${sen_geral} | Red Dot: ${sen_reddot} | Mira 2X: ${sen_2x} | Mira 4X: ${sen_4x} | AWM: ${sen_awm} | Olhadinha: ${sen_olhadinha}${NC}"
    echo -e "${COLOR_SECONDARY} ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}\n"
    
    read -r -p " 👾 Deseja aplicar os códigos de X e Y gerados agora? (S/N): " resp_aplicar
    resp_aplicar=$(echo "$resp_aplicar" | tr -d '\r')
    if [[ "$resp_aplicar" =~ ^[Ss]$ ]]; then
        setprop debug.touch.x_multiplier "$mult_x" > /dev/null 2>&1
        setprop debug.touch.y_multiplier "$mult_y" > /dev/null 2>&1
        setprop persist.sys.input.x.speed max > /dev/null 2>&1
        setprop persist.sys.input.y.speed max > /dev/null 2>&1
        setprop persist.sys.dispatch.y_bias 0.30 > /dev/null 2>&1
        echo -e "\n${COLOR_SECONDARY} 👾 [✔] EIXOS X E Y DO FREE FIRE APLICADOS COM SUCESSO!${NC}"
    else
        echo -e "\n${GRAY} Configuração visualizada, não injetada.${NC}"
    fi
    echo ""
    read -r -p " 👾 Pressione [Enter] para voltar ao menu..." dummy
}

configurar_xy_freefire() {
    exibir_cabecalho
    echo -e "${COLOR_SECONDARY} ╭───────────────────────────────────────────────────╮${NC}"
    echo -e "${COLOR_SECONDARY} │${WHITE}  👾 CONFIGURAR MODO EMULADOR (SENSIBILIDADE)      ${COLOR_SECONDARY} │${NC}"
    echo -e "${COLOR_SECONDARY} ╰───────────────────────────────────────────────────╯${NC}"
    echo ""
    
    local modelo_detectado=$(getprop ro.product.model 2>/dev/null)
    if [ -z "$modelo_detectado" ]; then modelo_detectado="POCO F8"; fi
    
    read -r -p " 👾 Digite o modelo do seu celular: " celular_user
    celular_user=$(echo "$celular_user" | tr -d '\r')
    if [ -z "$celular_user" ]; then celular_user="$modelo_detectado"; fi
    
    echo ""
    read -r -p " 👾 Deseja ativar X, Y e resolução recomendada para ${celular_user}? (S/N): " resp_ativar
    resp_ativar=$(echo "$resp_ativar" | tr -d '\r')
    if [[ ! "$resp_ativar" =~ ^[Ss]$ ]]; then
        echo -e "\n${GRAY} Operação cancelada.${NC}"
        echo ""
        read -r -p " 👾 Pressione [Enter] para voltar ao menu..." dummy
        return
    fi
    
    setprop debug.touch.x_multiplier "3.2" > /dev/null 2>&1
    setprop debug.touch.y_multiplier "3.7" > /dev/null 2>&1
    setprop persist.sys.dispatch.y_bias "0.28" > /dev/null 2>&1
    setprop persist.sys.input.x.speed max > /dev/null 2>&1
    setprop persist.sys.input.y.speed max > /dev/null 2>&1
    setprop debug.touch.ghost_filter 1 > /dev/null 2>&1
    setprop persist.sys.aim.stabilizer 1 > /dev/null 2>&1
    
    echo -e "\n${COLOR_SECONDARY} 👾 [!] INJETANDO REGEDIT DE EIXOS X E Y PARA FREE FIRE...${NC}"
    sleep 0.8
    
    echo -e "\n${WHITE} 👾 [✔] EIXOS X E Y DO SISTEMA CONFIGURADOS:${NC}"
    echo -e " ${GRAY}• Multiplicador X (Horizontal): ${WHITE}3.2${NC}"
    echo -e " ${GRAY}• Multiplicador Y (Vertical): ${WHITE}3.7${NC}"
    echo -e " ${GRAY}• Viés de Puxada Y: ${WHITE}0.28${NC}"
    
    echo -e "\n${COLOR_SECONDARY} 👾 SENSIBILIDADE CALCULADA PARA ${celular_user} (100 A 200):${NC}"
    echo -e " ${WHITE} GERAL      : ${COLOR_SECONDARY}185${NC}"
    echo -e " ${WHITE} RED DOT    : ${COLOR_SECONDARY}180${NC}"
    echo -e " ${WHITE} MIRA 2X    : ${COLOR_SECONDARY}172${NC}"
    echo -e " ${WHITE} MIRA 4X    : ${COLOR_SECONDARY}165${NC}"
    echo -e " ${WHITE} AWM        : ${COLOR_SECONDARY}150${NC}"
    echo -e " ${WHITE} OLHADINHA  : ${COLOR_SECONDARY}160${NC}"
    
    echo -e "\n${COLOR_SECONDARY} 👾 [★] SENSIBILIDADE E EIXOS X E Y APLICADOS COM SUCESSO!${NC}"
    echo ""
    read -r -p " 👾 Pressione [Enter] para voltar ao menu..." dummy
}

injetar_boneco_lento() {
    exibir_cabecalho
    echo -e "${COLOR_SECONDARY} 👾 [!] INJETANDO TWEAK BONECO LENTO + GPU ADRENO 630...${NC}"
    echo -e "${GRAY} Aplicando Boneco lento e aceleração de GPU...${NC}\n"
    
    setprop ro.hardware.egl adreno > /dev/null 2>&1
    setprop ro.product.gpu "Qualcomm Adreno 630" > /dev/null 2>&1
    setprop debug.egl.hw 1 > /dev/null 2>&1
    setprop debug.renderengine.backend skiagl > /dev/null 2>&1
    setprop persist.sys.composition.type gpu > /dev/null 2>&1
    setprop debug.sf.fps 120 > /dev/null 2>&1
    setprop debug.touch.latency 0 > /dev/null 2>&1
    setprop persist.sys.touch.response max > /dev/null 2>&1
    
    echo -e "${WHITE} 👾 [✔] Perfil de GPU Adreno 630 emulado com sucesso para o Free Fire.${NC}"
    echo -e "${WHITE} 👾 [✔] Códigos de renderização gráfica e aceleração aplicados.${NC}"
    echo -e "${WHITE} 👾 [✔] Driver EGL / RenderEngine ajustado para SkiaGL.${NC}"
    echo -e "\n${COLOR_SECONDARY} 👾 [★] TWEAK BONECO LENTO E GPU ADRENO 630 APLICADOS, 7VN!${NC}"
    echo ""
    read -r -p " 👾 Pressione [Enter] para voltar ao menu..." dummy
}

otimizar_rede() {
    exibir_cabecalho
    echo -e "${COLOR_SECONDARY} 👾 [!] AJUSTANDO PILHA TCP/IP E ROTAS DNS PARA FREE FIRE...${NC}\n"
    
    setprop net.dns1 1.1.1.1 > /dev/null 2>&1
    setprop net.dns2 1.0.0.1 > /dev/null 2>&1
    setprop persist.sys.nv_ping_optim 1 > /dev/null 2>&1
    
    echo -e "${WHITE} 👾 [✔] DNS Cloudflare (1.1.1.1) injetado.${NC}"
    echo -e "${WHITE} 👾 [✔] Pacotes de alta velocidade estabilizados.${NC}"
    echo -e "\n${COLOR_SECONDARY} 👾 [★] PING OTIMIZADO PARA O FREE FIRE, 7VN!${NC}"
    echo ""
    read -r -p " 👾 Pressione [Enter] para voltar ao menu..." dummy
}

limpar_ram() {
    exibir_cabecalho
    echo -e "${COLOR_SECONDARY} 👾 [!] EXECUTANDO LIMPEZA PROFUNDA DE MEMÓRIA PARA O FREE FIRE...${NC}\n"
    
    setprop dalvik.vm.drop_heap 1 > /dev/null 2>&1
    sync
    
    echo -e "${WHITE} 👾 [✔] Cache de aplicativos liberado.${NC}"
    echo -e "${WHITE} 👾 [✔] Buffer de textura GPU resetado.${NC}"
    echo -e "${WHITE} 👾 [✔] Memória Heap Dalvik otimizada.${NC}"
    echo -e "\n${COLOR_SECONDARY} 👾 [★] MEMÓRIA RAM LIMPA E OTIMIZADA PARA O FREE FIRE, 7VN!${NC}"
    echo ""
    read -r -p " 👾 Pressione [Enter] para voltar ao menu..." dummy
}

alterar_ms_click() {
    exibir_cabecalho
    echo -e "${COLOR_SECONDARY} ╭───────────────────────────────────────────────────╮${NC}"
    echo -e "${COLOR_SECONDARY} │${WHITE}  👾 CONFIGURAÇÃO DE LATÊNCIA DE CLICK (MS / CPS)  ${COLOR_SECONDARY} │${NC}"
    echo -e "${COLOR_SECONDARY} ├───────────────────────────────────────────────────┤${NC}"
    echo -e "${COLOR_SECONDARY} │${WHITE}  [1] 👾 10 ms (Ultra Instantâneo - Max CPS)        ${COLOR_SECONDARY} │${NC}"
    echo -e "${COLOR_SECONDARY} │${WHITE}  [2] 👾 20 ms (Alta Resposta - Competitivo FF)     ${COLOR_SECONDARY} │${NC}"
    echo -e "${COLOR_SECONDARY} │${WHITE}  [3] 👾 30 ms (Rápido & Estável)                   ${COLOR_SECONDARY} │${NC}"
    echo -e "${COLOR_SECONDARY} │${WHITE}  [4] 👾 50 ms (Equilibrado)                        ${COLOR_SECONDARY} │${NC}"
    echo -e "${COLOR_SECONDARY} │${WHITE}  [5] 👾 100 ms (Padrão Android)                    ${COLOR_SECONDARY} │${NC}"
    echo -e "${COLOR_SECONDARY} ╰───────────────────────────────────────────────────╯${NC}"
    echo ""
    echo -n -e " 👾 ESCOLHA A LATÊNCIA (MS), 7VN [1-5]: "
    read -r op_ms
    op_ms=$(echo "$op_ms" | tr -dc '0-9')
    
    local ms_val=10
    case "$op_ms" in
        1) ms_val=10 ;;
        2) ms_val=20 ;;
        3) ms_val=30 ;;
        4) ms_val=50 ;;
        5) ms_val=100 ;;
        *) ms_val=10 ;;
    esac
    
    setprop debug.touch.latency $ms_val > /dev/null 2>&1
    setprop persist.sys.input.latency $ms_val > /dev/null 2>&1
    CLICK_MS="${ms_val} ms"
    
    echo -e "\n${WHITE} 👾 [✔] Latência do Touch configurada para ${COLOR_SECONDARY}${ms_val} ms${WHITE}!${NC}"
    sleep 1.2
}

diagnostico_problemas() {
    exibir_cabecalho
    echo -e "${COLOR_SECONDARY} 👾 [!] VARREDURA DE PERFORMANCE AUTOMÁTICA NO FREE FIRE...${NC}\n"
    sleep 0.5
    
    if [ -f "$FIXED_FILE" ]; then
        echo -e "${WHITE} 👾 [✔] NENHUM ERRO ENCONTRADO!${NC}"
        echo -e "${GRAY} Gargalos de Renderização GPU: ${WHITE}RESOLVIDO${NC}"
        echo -e "${GRAY} Atraso de Touch (Ghost Touch): ${WHITE}RESOLVIDO${NC}\n"
        echo -e "${COLOR_SECONDARY} 👾 [★] O sistema já está operando com calibração máxima, 7VN!${NC}\n"
        
        read -r -p " 👾 Deseja redefinir o diagnóstico e testar novamente? (S/N): " retest
        retest=$(echo "$retest" | tr -d '\r')
        if [[ "$retest" =~ ^[Ss]$ ]]; then
            rm -f "$FIXED_FILE"
            echo -e "\n${GRAY} Diagnóstico resetado.${NC}"
        fi
    else
        echo -e "${COLOR_SECONDARY} 👾 [X] ERRO DETECTADO: ${WHITE}Gargalo de Renderização da GPU.${NC}"
        echo -e "${COLOR_SECONDARY} 👾 [X] ERRO DETECTADO: ${WHITE}Atraso do Digitalizador de Toque.${NC}\n"
        
        echo "$(date): Throttle de Renderização, Latência no Touch." > "$LOG_FILE"
        echo -e "${WHITE} 👾 Deseja resolver bugs de FPS, Touch, Toque Fantasma e Acelerar Sensibilidade agora, 7VN?${NC}"
        read -r -p " 👾 (S/N): " resposta
        resposta=$(echo "$resposta" | tr -d '\r')
        
        if [[ "$resposta" =~ ^[Ss]$ ]]; then
            echo -e "\n${COLOR_SECONDARY} 👾 [!] APLICANDO CORREÇÕES DE HARDWARE...${NC}"
            setprop debug.touch.no_recoil 1 > /dev/null 2>&1
            setprop persist.sys.aim.stabilizer 1 > /dev/null 2>&1
            setprop debug.touch.ghost_filter 1 > /dev/null 2>&1
            echo "CORRIGIDO" > "$FIXED_FILE"
            echo "$(date): Todos os problemas de Touch e GPU foram resolvidos." > "$LOG_FILE"
            echo -e "${COLOR_SECONDARY} 👾 [✔] MATRIZ DE TOUCH RECALIBRADA E PROBLEMAS RESOLVIDOS!${NC}"
        else
            echo -e "\n${GRAY} Cancelado por 7VN.${NC}"
        fi
    fi
    echo ""
    read -r -p " 👾 Pressione [Enter] para voltar ao menu..." dummy
}

log_problemas() {
    exibir_cabecalho
    echo -e "${COLOR_SECONDARY} ╭─── 👾 LOG DE DIAGNÓSTICOS (OPERADOR 7VN) ───╮${NC}\n"
    if [ -f "$LOG_FILE" ]; then
        echo -e "${WHITE} $(cat "$LOG_FILE")${NC}"
    else
        echo -e "${GRAY} Nenhum registro salvo.${NC}"
    fi
    echo -e "\n${COLOR_SECONDARY} ╰──────────────────────────────────────────╯${NC}\n"
    read -r -p " 👾 Pressione [Enter] para voltar ao menu..." dummy
}

# ==========================================
# INICIALIZAÇÃO DO SCRIPT
# ==========================================
carregar_tema

# ==========================================
# MENU PRINCIPAL
# ==========================================
while true; do
    exibir_cabecalho
    echo -e "${COLOR_SECONDARY} ╭───────────────────────────────────────────────────╮${NC}"
    echo -e "${COLOR_SECONDARY} │${WHITE}  [1] 👾 CONFIGURAR SEU MODO EMULADOR            ${COLOR_SECONDARY} │${NC}"
    echo -e "${COLOR_SECONDARY} │${WHITE}  [2] 👾 GERE SUA X E Y (PELO MODELO DO CELULAR) ${COLOR_SECONDARY} │${NC}"
    echo -e "${COLOR_SECONDARY} │${WHITE}  [3] 👾 CONFIGURAR SUA X E Y FREE FIRE          ${COLOR_SECONDARY} │${NC}"
    echo -e "${COLOR_SECONDARY} │${WHITE}  [4] 👾 INJETAR TWEAK BONECO LENTO (GPU 630)    ${COLOR_SECONDARY} │${NC}"
    echo -e "${COLOR_SECONDARY} │${WHITE}  [5] 👾 OTIMIZAR PING E REDE FREE FIRE          ${COLOR_SECONDARY} │${NC}"
    echo -e "${COLOR_SECONDARY} │${WHITE}  [6] 👾 DEEP RAM CLEANER (LIMPAR CACHE/BUFFERS)  ${COLOR_SECONDARY} │${NC}"
    echo -e "${COLOR_SECONDARY} │${WHITE}  [7] 👾 ALTERAR MS DE CLICK POR SEGUNDO (CPS)   ${COLOR_SECONDARY} │${NC}"
    echo -e "${COLOR_SECONDARY} │${WHITE}  [8] 👾 DIAGNÓSTICO DE PERFORMANCE FF           ${COLOR_SECONDARY} │${NC}"
    echo -e "${COLOR_SECONDARY} │${WHITE}  [9] 👾 LOG DE PROBLEMAS                        ${COLOR_SECONDARY} │${NC}"
    echo -e "${COLOR_SECONDARY} │${WHITE} [10] 👾 ALTERAR TEMA DO PAINEL                  ${COLOR_SECONDARY} │${NC}"
    echo -e "${COLOR_SECONDARY} │${WHITE} [11] 👾 SAIR                                    ${COLOR_SECONDARY} │${NC}"
    echo -e "${COLOR_SECONDARY} ╰───────────────────────────────────────────────────╯${NC}"
    echo ""
    echo -n -e " 👾 ESCOLHA UMA OPÇÃO, 7VN: "
    read -r opcao
    
    opcao=$(echo "$opcao" | tr -dc '0-9')
    
    case "$opcao" in
        1) configurar_eixos_xy ;;
        2) gerar_xy ;;
        3) configurar_xy_freefire ;;
        4) injetar_boneco_lento ;;
        5) otimizar_rede ;;
        6) limpar_ram ;;
        7) alterar_ms_click ;;
        8) diagnostico_problemas ;;
        9) log_problemas ;;
        10) selecionar_tema ;;
        11) 
            echo -e "\n${COLOR_SECONDARY} 👾 [!] Painel Free Fire encerrado, 7VN. Bom jogo!${NC}\n"
            exit 0 
            ;;
        *) 
            echo -e "\n${WHITE} 👾 Opção inválida, 7VN!${NC}"
            sleep 0.8 
            ;;
    esac
done
EOF
sed -i 's/\r$//' painel.sh
chmod +x painel.sh
./painel.sh
